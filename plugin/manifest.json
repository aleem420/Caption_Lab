{
  "manifestVersion": 5,
  "id": "com.captionlab.premiere",
  "name": "CaptionLab",
  "version": "1.2.0",
  "main": "dist/index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "captionlab.panel",
      "name": "CaptionLab Studio",
      "minimumSize": {
        "width": 380,
        "height": 550
      },
      "preferredSize": {
        "width": 460,
        "height": 720
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://localhost:8765"
      ]
    },
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon_24.png"
    }
  ]
}
